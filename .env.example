# ============================================================
# 本地开发默认值（可直接复制为 .env 后 npm start）
# 生产部署请按文件末尾「生产环境必须修改」逐项调整
# ============================================================
NODE_ENV=development
HOST=127.0.0.1
PORT=3600
# 业务时区：日报按此时区切天（IANA 名称）
TZ_NAME=Asia/Shanghai
DB_PATH=./data/scout.db
LOG_LEVEL=info

# 反向代理（Nginx/Caddy）后面部署时设为 1，才能取到真实客户端 IP
TRUST_PROXY=0
# HTTPS 部署必须为 1（Cookie 加 Secure）；本地 HTTP 访问必须为 0
COOKIE_SECURE=0
# 随机 32+ 字符：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_TTL_DAYS=7

# 首次启动创建所有者账号（至少 10 位，含字母与数字）
# 留空且非生产环境时，会自动创建演示账号 demo@scout.local / demo12345
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# 公开演示站：只读演示账号自动登录；生产不要开启
DEMO_MODE=0
# 首次启动是否写入演示商品池（生产设为 0）
IMPORT_ON_BOOT=1

# ---- LLM 日报（可选，不配置则用规则引擎）----
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_MS=45000
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=1200
# 每百万 token 的美元价，用于成本记账；不填则用内置价目表
LLM_PRICE_IN=
LLM_PRICE_OUT=

# ---- 定时任务 ----
ENABLE_CRON=1
REPORT_CRON_HOUR=8
REPORT_CRON_MINUTE=0
SNAPSHOT_INTERVAL_HOURS=6
# 是否把日报额外写入 reports/ 目录（容器部署建议 0）
REPORT_WRITE_FILES=0

# ---- 安全 ----
MAX_BODY_BYTES=262144
# 测试环境可设为 1 关闭限流
RATE_LIMIT_DISABLED=0
# 仅内网自建 Webhook 时才放开（SSRF 防护）
WEBHOOK_ALLOW_PRIVATE=0
WEBHOOK_ALLOW_HTTP=0

# ---- 数据源 ----
# manual | csv | push | google-trends
DATA_PROVIDER=manual

# ============================================================
# 生产环境必须修改：
#   NODE_ENV=production
#   HOST=0.0.0.0（配合反向代理时可保持 127.0.0.1）
#   TRUST_PROXY=1
#   COOKIE_SECURE=1（必须 HTTPS）
#   SESSION_SECRET=<32+ 随机字符>
#   BOOTSTRAP_ADMIN_EMAIL / PASSWORD=<强密码>
#   IMPORT_ON_BOOT=0
#   DEMO_MODE=0
#   REPORT_WRITE_FILES=0
# 并把 data/ 挂载到持久化卷、配置每日备份。
# ============================================================
